{
	"name": "DF_Enrich_Orders",
	"properties": {
		"description": "Enrich orders",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_factOrders",
						"type": "DatasetReference"
					},
					"name": "RawSource"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_dimCustomer",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_dimProducts",
						"type": "DatasetReference"
					},
					"name": "Products"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_SQL_factOrders",
						"type": "DatasetReference"
					},
					"name": "FinalDestination"
				}
			],
			"transformations": [
				{
					"name": "OrdersWithCustomers"
				},
				{
					"name": "OrdersEnrich"
				},
				{
					"name": "WithProfit"
				},
				{
					"name": "FinalEnriched"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          Paymentmethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> RawSource",
				"source(output(",
				"          CustomerID as string,",
				"          Fullname as string,",
				"          Email as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          Customersegment as string,",
				"          Joindate as date,",
				"          LoadAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Customers",
				"source(output(",
				"          ProductID as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Subcategory as string,",
				"          Brand as string,",
				"          UnitPrice as decimal(10,2),",
				"          CostPrice as decimal(10,2),",
				"          Supplier as string,",
				"          Isactive as boolean,",
				"          LoadAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Products",
				"RawSource, Customers join(RawSource@CustomerID == Customers@CustomerID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrdersWithCustomers",
				"OrdersWithCustomers, Products join(RawSource@ProductID == Products@ProductID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrdersEnrich",
				"OrdersEnrich derive(CostOfGoods = Quantity*CostPrice,",
				"          GrossProfit = NetRevenue - Quantity*CostPrice,",
				"          ProfitMarginPct = (NetRevenue - Quantity*CostPrice) / iif(NetRevenue == toDecimal(0), toDecimal(1), NetRevenue) * toDecimal(100)) ~> WithProfit",
				"WithProfit select(mapColumn(",
				"          OrderID,",
				"          CustomerID = RawSource@CustomerID,",
				"          ProductID = RawSource@ProductID,",
				"          Customername,",
				"          Productname = RawSource@Productname,",
				"          Category = RawSource@Category,",
				"          Orderdate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice = RawSource@UnitPrice,",
				"          Discountpct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          NetRevenue,",
				"          CostofGoods = RawSource@CostofGoods,",
				"          GrossProfit,",
				"          Paymentmethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region,",
				"          LoadAt = RawSource@LoadAt,",
				"          CustomerID = Customers@CustomerID,",
				"          Fullname,",
				"          Email,",
				"          City,",
				"          State,",
				"          Country,",
				"          Customersegment,",
				"          Joindate,",
				"          LoadAt = Customers@LoadAt,",
				"          ProductID = Products@ProductID,",
				"          Productname = Products@Productname,",
				"          Category = Products@Category,",
				"          Subcategory,",
				"          Brand,",
				"          UnitPrice = Products@UnitPrice,",
				"          CostPrice,",
				"          Supplier,",
				"          Isactive,",
				"          LoadAt = Products@LoadAt,",
				"          CostOfGoods = WithProfit@CostOfGoods,",
				"          ProfitMarginPct",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FinalEnriched",
				"FinalEnriched sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          Paymentmethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['truncate table dbo.fact_orders'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          OrderID,",
				"          CustomerID,",
				"          ProductID,",
				"          Customername,",
				"          Productname,",
				"          Category,",
				"          Orderdate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice,",
				"          Discountpct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          NetRevenue,",
				"          CostofGoods = FinalEnriched@CostofGoods,",
				"          GrossProfit,",
				"          Paymentmethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region",
				"     )) ~> FinalDestination"
			]
		}
	}
}